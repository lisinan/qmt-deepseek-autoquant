# 敏感文件
trading_config.json
storage/*.db
storage/*.db-wal
storage/*.db-shm
# 账本复位的一次性标志（运行时产物）
storage/.reset_paper.flag
logs/*.log
logs/*.log.*
# 密钥：.env 含 API key，绝不提交；.env.example 是安全模板可提交
.env
.env.local
*.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# IDE
.idea/
.vscode/
*.swp
.DS_Store
# 测试 / 缓存产物
.pytest_cache/
.workbuddy/
storage/hist_cache/
data/cache/
sweep.log
logs/*.json
logs/*.txt
logs/engine.pid
logs/STOP_ENGINE
_backup/
logs/*.bak
# 运行时 PID 锁（守护/引擎），非源码
.guardian.pid
# 【2026-10-24】运行时数据（每日追加 / 可重建），不纳入版本管理：
#   benchmark_daily.jsonl —— 每日基准超额（B4 管道产出）
#   gate_timeline.jsonl   —— 每日闸门通过数（可由 scripts/_res_gate_timeline_backfill.py 重建）
logs/benchmark_daily.jsonl
logs/gate_timeline.jsonl
# DB 维护备份（体积大，本地留存即可）
storage/qmt.db.bak-*
# guardian 降级告警的按天去重标记（运行时产物）
logs/.guardian_alert_last
