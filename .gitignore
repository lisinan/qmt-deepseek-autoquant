# 【2026-10-24】运行时数据（每日追加 / 可重建），不纳入版本管理：
#   benchmark_daily.jsonl —— 每日基准超额（B4 管道产出）
#   gate_timeline.jsonl   —— 每日闸门通过数（可由 scripts/_res_gate_timeline_backfill.py 重建）
logs/benchmark_daily.jsonl
logs/gate_timeline.jsonl
# DB 维护备份（体积大，本地留存即可）
storage/qmt.db.bak-*
# guardian 降级告警的按天去重标记（运行时产物）
logs/.guardian_alert_last

# 一次性数据修正前的备份（本地保留，不进版本库）
logs/*.bak-*

# ============================================================================
# 【2026-11-08】zone=paper 平行观察台的运行时产物（全部本地留存）
# ----------------------------------------------------------------------------
# 为什么要单独写：现有的 `storage/*.db` / `logs/*.log` 规则只覆盖单层，
# `storage_paper/qmt.db` 与 `logs_paper/quant_system.log` 都不匹配。
# 这些是 paper 区的账本/日志/桥接投信桶，属于可重建的运行时数据，
# 且 paper 账本的绝对收益与 live 不可比（起始资金 100 万 vs 5.8 万），
# 入库只会污染复盘与账本审计。
# ============================================================================
storage_paper/
logs_paper/

# ============================================================================
# 【2026-11-08】一次性券商/交易通道探针（含明文账号风险，永不入库）
# ----------------------------------------------------------------------------
# 为什么单列：这些是 11-03 排障时写的一次性脚本，不在 tests/run_all.py 里，
# 也没有任何自动任务引用；但 `_probe_xttrader_admin.py` 曾经硬编码真实券商账号
# （2026-11-08 已改为读 QMT_ACCOUNT_ID 环境变量）。仓库是 public，任何一次
# `git add -A` 都会把账号推上去，且 git 历史不可回收 ⇒ 用规则挡住，不靠自觉。
# ============================================================================
scripts/_probe_xttrader_admin.py
scripts/_probe_admin.bat
scripts/_probe_admin_result.txt
scripts/_repro_qmt_launch.py

# Agent 生成的配置提议文件：与 settings.py 逐字节同源，仅供 OWNER cp，不入库
# （否则同一份配置在历史里存两遍，且会随 settings 漂移）
config/settings.py.proposed-*
*.proposed-*

# ============================================================================
# 【2026-11-10】补丁脚本留的本地回滚点（`<file>.bak-YYYYMMDD[-HHMM][-bn]`）
# ----------------------------------------------------------------------------
# 为什么单列：`scripts/patch_*.py` 落盘前会对每个被改文件做逐字节备份，命名
# 形如 `engine/event_engine.py.bak-20261110-1330`。这些是**本地回滚点**，
# 不是产物：入会让 diff 里混进几份完整源码副本，且下次 diff 会互相污染。
# 判据：仓库当前没有任何 .bak 文件被跟踪（`git ls-files | grep .bak` 为空），
#   所以按日期模式整体忽略不会误伤既有产物。
# 回滚：删本段即可；已被忽略的历史 .bak 文件仍在磁盘上，未删除。
# ============================================================================
*.bak-20*


# ============================================================================
# 【2026-11-10】OWNER 指令队列：**运行时状态，不是源码**
# ----------------------------------------------------------------------------
# `storage/owner_orders.jsonl` 是 OWNER 手写下单的追加队列，
# `storage/owner_orders_done.json` 是它的幂等账本（记 id / 状态 / 成交原因）。
# 两者都含**真实委托号**（如 0165315089）与逐笔成交价量 —— 本仓库是 public，
# 这类信息属于账户交易细节，不入库。
# 副作用说明：忽略它们不影响功能 —— 通道按路径读写磁盘文件，与 git 无关。
# 需要留档的指令请写进 `reports/` 下的复盘，而不是把队列提交上来。
# ============================================================================
storage/owner_orders.jsonl
storage/owner_orders_done.json
storage/owner_orders*.json.tmp
storage/owner_orders_done.json.tmp
storage_paper/owner_orders.jsonl
storage_paper/owner_orders_done.json

# 临时产物（2026-11-10 清理）：`nul` 是 Windows 重定向写坏的 0 字节文件，
# `t.json*` 是手工探针的草稿输出，`logs/_tmp/` 是沙箱副本（整份仓库快照）。
nul
t.json
t.json.new
logs/_tmp/
