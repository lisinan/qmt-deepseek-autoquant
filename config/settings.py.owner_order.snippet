# ============================================================================
# OWNER 指令单通道 —— 待粘贴片段（2026-11-10）
#
# 用法：把下面 "owner_order" 整块，粘贴到 config/settings.py 的
#       STRATEGY_PARAMS = { ... } 字典内部（建议放在 "manual_entry_codes" 那一行
#       之后，约第 613 行附近；位置不影响功能，只要在字典里）。
#
# 注意事项：
# 1. 缩进必须与同字典内其它键一致（4 空格）。
# 2. 末尾逗号不能少，否则与下一个键粘连。
# 3. 改完保存 → 重启引擎 → 通道生效。enabled=False 时等价于未安装。
# ============================================================================

    # ===== OWNER 指令单通道（2026-11-10 v1.1）=====
    # 允许对已持仓加仓、也允许卖出——这是全系统唯一能这样做的路径。
    # 落单仍走 _handle_buy / _handle_sell（唯一落单口），
    # 熔断 / 日内次数 / 现金夹紧 / 行情新鲜度 / T+1 / 建仓保护期全部照旧生效。
    # 幂等：同 id 永不重复提交（storage/owner_orders_done.json 落盘）。
    "owner_order": {
        "enabled": True,         # ← 启用开关
        "max_amount": 1000.0,    # 单笔金额上限（元）——先小，跑顺再抬
        "max_per_day": 5,        # 每日指令条数上限
    },
