# qmtIDE-deepseek 环境变量模板（复制为 .env 后填入真实密钥，.env 已被 .gitignore 忽略）
# 复制本文件：cp .env.example .env

# qmtIDE-deepseek 本地密钥（已被 .gitignore 忽略，勿提交到版本库）
# 启用方式：直接在项目根目录 .env 写入即可，无需改源码。

# —— LLM / AI 分析层 ——
# 优先使用 DeepSeek 官方直连（有 key 时自动优先于 OpenRouter，直连更稳）
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE

# OpenRouter 保持静默（未配置 key，不启用）。
# 如需改用免费模型，取消下行注释并填入 OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE 即可。
# OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE

# —— Tushare 基本面数据 ——
TUSHARE_TOKEN=YOUR_TUSHARE_TOKEN_HERE
